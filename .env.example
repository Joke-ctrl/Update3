APP_ENV=development
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Admin-gated auth: registration-approval codes go to the admin only
# (Telegram first, this email as fallback) — never to the registering
# user. Login OTPs also go to the admin's Telegram chat first now,
# falling back to the logging-in user's own email only if Telegram fails.
ADMIN_EMAIL=privateinv08@gmail.com
REGISTRATION_CODE_LENGTH=8
REGISTRATION_CODE_EXPIRE_MINUTES=4320
# Set to false to skip the login-OTP second factor and issue tokens
# directly on a successful password check.
LOGIN_OTP_ENABLED=true
LOGIN_OTP_LENGTH=6
LOGIN_OTP_EXPIRE_MINUTES=10

# SMTP - required in production for registration/OTP emails to actually
# send. Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=<your gmail>, SMTP_PASSWORD=<app password, not your login password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@marketkill3r.app

# Telegram Bot API - primary channel for both registration-approval
# codes and login OTPs; falls back to SMTP email above whenever Telegram
# is unset, unreachable,
# or returns an error. Create a bot via @BotFather to get a bot token,
# then message your bot once and read your chat_id back from
# https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_ENABLED=true
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MT5_API_KEY=
CALENDAR_API_KEY=
NEWS_RSS_FEEDS=["https://www.cnbc.com/id/10000664/device/rss/rss.html","https://www.cnbc.com/id/15839135/device/rss/rss.html"]
ANTHROPIC_API_KEY=
DEFAULT_ANALYSIS_TIMEFRAMES=["H4","H1","M15"]
ANALYSIS_MIN_BARS=100

# Optional market data
LIVE_RATES_URL=https://live-rates.com/api/rates
LIVE_RATES_API_KEY=
XAUS_SPOT_URL=https://xaus.com/api/v1/spot
TWELVE_DATA_API_KEY=
FMP_API_KEY=
